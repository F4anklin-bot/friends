Animations requises (Framer Motion)
typescript
// Page transition
const pageTransition = {
  initial: { opacity: 0, x: 20 },
  animate: { opacity: 1, x: 0 },
  exit: { opacity: 0, x: -20 },
  transition: { duration: 0.3, ease: "easeOut" }
};

// Card flip (pour révélation rôles)
const cardFlip = {
  rotateY: [0, 90, 90, 0],
  transition: { duration: 0.6 }
};

// Pulse interaction
const pulse = {
  scale: [1, 1.05, 1],
  transition: { repeat: Infinity, duration: 2 }
};
