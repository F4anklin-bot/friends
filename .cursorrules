└── types/              # TypeScript interfaces
Stack technique obligatoire
Frontend: React 18+ + TypeScript + Vite
State: Zustand (global) + React Query (server)
Styling: TailwindCSS + CSS Modules
Animations: Framer Motion
Backend: Node.js + Express + Socket.io
Database: PostgreSQL + Prisma ORM
Storage: localStorage (offline) + sync PostgreSQL
Icons: Lucide React + Custom SVG
Performance requirements
First Contentful Paint < 1.5s
Time to Interactive < 3s
Animations jank-free (60fps)
Bundle size < 200KB initial
🛡️ RÈGLES ANTI-TRICHE (IMPOSTEUR)
Détection automatique
typescript
// Dans le service de chat/discussion
const forbiddenWordDetection = (message: string, secretWord: string): boolean => {
  const normalized = message.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  const wordNormalized = secretWord.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
  
  // Détection exacte + variations + mots proches (Levenshtein distance < 2)
  return normalized.includes(wordNormalized) || 
         calculateLevenshtein(normalized, wordNormalized) <= 2;
};

// Action si détection
const handleCheatingAttempt = (playerId: string) => {
